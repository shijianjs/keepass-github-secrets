<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProductVersion>9.0.30729</ProductVersion>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{4C1BB6F8-D2CD-49C2-9053-21705681356C}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>KeePassGitHubSecrets</RootNamespace>
    <AssemblyName>KeePassGitHubSecrets</AssemblyName>
    <SignAssembly>false</SignAssembly>
    <AssemblyOriginatorKeyFile>
    </AssemblyOriginatorKeyFile>
    <!-- KeePass.exe is a .NET Framework app, so the plugin must target the same framework. -->
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>..\..\Build\KeePassGitHubSecrets\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KeePass">
      <HintPath>dist\KeePass-2.62\KeePass.exe</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="KeePassGitHubSecretsExt.cs" />
    <Compile Include="SecretEntryModel.cs" />
    <Compile Include="GhCli.cs" />
    <Compile Include="SyncDialog.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="dist\data\test-database.md" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
  <!-- Local test environment: copy the DLL straight into the green KeePass under dist\. -->
  <Target Name="DeployPlugin" AfterTargets="Build">
    <PropertyGroup>
      <PluginDir>dist/KeePass-2.62/Plugins</PluginDir>
    </PropertyGroup>

    <MakeDir Directories="$(PluginDir)" />

    <Copy
            SourceFiles="$(TargetPath)"
            DestinationFolder="$(PluginDir)"
            SkipUnchangedFiles="true" />
  </Target>
</Project>
